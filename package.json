{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "spot-sdk-js",
  "version": "1.1.0",
  "description": "Develop applications and payloads for Spot using the unofficial Boston Dynamics Spot Node.js SDK.",
  "scripts": {
    "build": "node build.js",
    "build:docs": "npm run build:typings && node build_docs.js",
    "build:typings": "node build_typings.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node test/run.js",
    "test:typings": "tsc -p test/typings/tsconfig.json",
    "prepublishOnly": "npm run lint && npm run test:typings && npm test",
    "docs": "docsify serve docs",
    "count": "count-code-line -e /examples/*/node_modules,/typings,/test/node_modules,/docs"
  },
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "exports": {
    ".": {
      "types": "./typings/index.d.ts",
      "default": "./src/index.js"
    },
    "./src/bosdyn-client": {
      "types": "./typings/bosdyn-client/index.d.ts",
      "default": "./src/bosdyn-client/index.js"
    },
    "./src/bosdyn-client/gps": {
      "types": "./typings/bosdyn-client/gps/index.d.ts",
      "default": "./src/bosdyn-client/gps/index.js"
    },
    "./src/bosdyn-client/spot_cam": {
      "types": "./typings/bosdyn-client/spot_cam/index.d.ts",
      "default": "./src/bosdyn-client/spot_cam/index.js"
    },
    "./src/bosdyn-core/bddf": {
      "types": "./typings/bosdyn-core/bddf/index.d.ts",
      "default": "./src/bosdyn-core/bddf/index.js"
    },
    "./src/bosdyn-orbit": {
      "types": "./typings/bosdyn-orbit/index.d.ts",
      "default": "./src/bosdyn-orbit/index.js"
    },
    "./src/bosdyn/*.js": "./src/bosdyn/*.js",
    "./src/bosdyn/*": "./src/bosdyn/*.js",
    "./src/*.js": {
      "types": "./typings/*.d.ts",
      "default": "./src/*.js"
    },
    "./src/*": {
      "types": "./typings/*.d.ts",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./src/bosdyn-client/command_line.js",
  "files": [
    "src",
    "typings"
  ],
  "directories": {
    "lib": "src",
    "example": "examples",
    "test": "test"
  },
  "author": "Théo Pierné <theo.pierne2@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "spot",
    "boston dynamics",
    "boston",
    "dynamics",
    "robot",
    "node",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TheoPierne/spot-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/TheoPierne/spot-sdk-js/issues"
  },
  "dependencies": {
    "@d4c/numjs": "^0.17.35",
    "@grpc/grpc-js": "^1.14.5",
    "@types/google-protobuf": "^3.15.12",
    "argparse": "^3.0.2",
    "axios": "^1.20.0",
    "google-protobuf": "^4.0.3",
    "lodash": "^4.18.1",
    "long": "^5.3.2",
    "luxon": "^3.7.2",
    "nmea-simple": "^3.3.0",
    "prompt": "^1.3.0",
    "python-struct": "^1.1.3",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "uuid": "^11.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@protocolbuffers/protoc-gen-js": "^4.0.3",
    "@types/node": "^24.19.0",
    "docsify-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "docsify@5.0.0": true,
    "grpc-tools@1.13.1": true,
    "protobufjs@7.6.6": true,
    "@protocolbuffers/protoc-gen-js@4.0.3": true
  }
}
