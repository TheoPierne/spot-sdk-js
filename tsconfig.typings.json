{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  // Generates the typings (typings/) from the JSDoc of src/: npm run build:typings.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "typings",
    "rootDir": "src",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["es2023", "esnext.disposable"],
    "types": ["node"],
    "skipLibCheck": true,
    "newLine": "lf",
    "removeComments": false
  },
  "include": ["src/**/*.js"],
  // The protobuf messages have their typings, generated by build.js.
  "exclude": ["src/bosdyn/**"]
}
